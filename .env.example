NODE_ENV=production
PORT=5000
# Cluster 1 (MAIN): users, dealers, inventory, sales, purchase invoices, expenses, PIN settings.
MAIN_MONGODB_URI=mongodb+srv://<username>:<password>@<main-cluster-host>/?retryWrites=true&w=majority
MAIN_MONGODB_DB=mobile_shop
# Cluster 2 (TAC): a SEPARATE Atlas cluster for TACRecords, TACImportLogs and invoice files (GridFS).
# If unset, TAC data falls back to the main cluster (a warning is logged).
TAC_MONGODB_URI=mongodb+srv://<username>:<password>@<tac-cluster-host>/?retryWrites=true&w=majority
TAC_MONGODB_DB=mobile_shop_tac
# Older name still accepted for the main cluster: MONGODB_URI / MONGODB_DB
MONGODB_MAX_POOL=10
# Max invoice attachment size (PDF/JPG/PNG), in MB.
INVOICE_MAX_FILE_MB=8
JWT_SECRET=replace-with-a-long-random-secret
SETUP_KEY=replace-with-a-different-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
HICELLTEK_API_KEY=
HICELLTEK_TIMEOUT_MS=10000

# Financial security PIN (all optional; secure defaults are derived from JWT_SECRET).
# Set FINANCIAL_PIN_PEPPER explicitly in production: if it (or JWT_SECRET, when it is unset) changes,
# existing PINs stop matching and must be reset with `npm run pin:reset`.
FINANCIAL_PIN_PEPPER=replace-with-a-long-random-secret
FINANCIAL_TOKEN_SECRET=replace-with-another-long-random-secret
# Key required (with the account password) to reset a forgotten PIN from the app. Defaults to SETUP_KEY.
FINANCIAL_PIN_RECOVERY_KEY=replace-with-a-third-long-random-secret
FINANCIAL_UNLOCK_MINUTES=5
FINANCIAL_PIN_MAX_ATTEMPTS=5
FINANCIAL_PIN_LOCKOUT_MINUTES=15
FINANCIAL_PIN_RATE_LIMIT=20
